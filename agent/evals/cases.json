  "extraction": [
    {
      "id": "ext-price-full",
      "category": "price_match",
      "transcript": [
        [
          "user",
          "I saw the Rose on Amazon for 340 rupees, can you match it?"
        ]
      ],
      "expect": {
        "product_name": "rose",
        "competitor_price": "340",
        "competitor_source": "amazon"
      }
    },
    {
      "id": "ext-price-missing-source",
      "category": "price_match",
      "transcript": [
        [
          "user",
          "Your Adenium is 300 but I saw it for 250 somewhere, can you match?"
        ]
      ],
      "expect": {
        "product_name": "adenium",
        "competitor_price": "250"
      },
      "expect_empty": [
        "competitor_source"
      ]
    },
    {
      "id": "ext-price-two-turns",
      "category": "price_match",
      "transcript": [
        [
          "user",
          "Can you match a lower price for the jade plant? I saw it for 80."
        ],
        [
          "assistant",
          "I'll get our team to help with this. Could you tell me where you found it?"
        ],
        [
          "user",
          "On Flipkart"
        ]
      ],
      "expect": {
        "product_name": "jade",
        "competitor_price": "80",
        "competitor_source": "flipkart"
      }
    },
    {
      "id": "ext-cancel",
      "category": "cancellation",
      "transcript": [
        [
          "user",
          "Please cancel order 2026100712 for me"
        ]
      ],
      "expect": {
        "order_number": "2026100712"
      }
    },
    {
      "id": "ext-damaged",
      "category": "damaged_item",
      "transcript": [
        [
          "user",
          "Order ORD555 came with a broken planter and the soil spilled everywhere"
        ]
      ],
      "expect": {
        "order_number": "ORD555",
        "issue_description": "broken"
      }
    },
    {
      "id": "ext-payment",
      "category": "payment_issue",
      "transcript": [
        [
          "user",
          "I was charged 1240 rupees yesterday but there's no order in my account"
        ]
      ],
      "expect": {
        "amount": "1240",
        "payment_date": "yesterday"
      }
    },
    {
      "id": "ext-no-guess",
      "category": "cancellation",
      "transcript": [
        [
          "user",
          "I want to cancel my order"
        ]
      ],
      "expect": {},
      "expect_empty": [
        "order_number"
      ]
    },
    {
      "id": "ext-withdraw",
      "category": "price_match",
      "transcript": [
        [
          "user",
          "Can you match a price for me?"
        ],
        [
          "assistant",
          "I'll get our team to help with this. Could you tell me which of our products it is?"
        ],
        [
          "user",
          "never mind, forget it"
        ]
      ],
      "expect": {
        "user_withdrew": true
      }
    }
  ],
  "replies": [
    {
      "id": "reply-price-approved",
      "category": "price_match",
      "collected": {
        "product_name": "Rose",
        "competitor_price": "340",
        "competitor_source": "Amazon"
      },
      "decision": {
        "action": "edit",
        "note": "We can do 10% on this one."
      },
      "outcome": "A 10% price match on Rose was approved. Our team will apply it and confirm the details with the customer.",
      "must_include": [
        "10%"
      ],
      "must_not_include": [
        "coupon code",
        "promo code",
        "15%",
        "refund"
      ]
    },
    {
      "id": "reply-cancel-rejected",
      "category": "cancellation",
      "collected": {
        "order_number": "ORD123"
      },
      "decision": {
        "action": "reject",
        "note": "The order was already handed to the courier."
      },
      "outcome": "Our team reviewed the request and was not able to approve it.",
      "must_include": [
        "courier"
      ],
      "must_not_include": [
        "has been cancelled",
        "refund has been"
      ]
    },
    {
      "id": "reply-cancel-approved",
      "category": "cancellation",
      "collected": {
        "order_number": "ORD123"
      },
      "decision": {
        "action": "approve",
        "note": ""
      },
      "outcome": "Order ORD123 has been cancelled. Any refund is processed to the original payment method.",
      "must_include": [
        "ORD123",
        "cancel"
      ],
      "must_not_include": [
        "within 24 hours",
        "coupon"
      ]
    }
  ]
}